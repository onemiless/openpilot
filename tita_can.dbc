CM_ SG_ 921 TL_State "0=Unknown 1=Red 2=Yellow_Flashing 3=Yellow 4=Red_Flashing 7=Green";
CM_ SG_ 921 TL_Countdown "Traffic light remaining time in seconds";
CM_ SG_ 921 TL_PhaseID "Intersection signal phase identifier";
CM_ SG_ 925 SLD_Distance "Distance to stop line in meters (0.1m resolution)";
CM_ SG_ 1097 Intersection_Reachable "Whether the intersection can be reached";
CM_ SG_ 978 Latitude "Latitude in degrees, 1e-7 resolution";
CM_ SG_ 978 Longitude "Longitude in degrees, 1e-7 resolution";
CM_ SG_ 306 Batt_Voltage "Battery total voltage";
CM_ SG_ 306 Batt_Current "Battery current, positive=discharge";
CM_ SG_ 789 Batt_SOC "Battery state of charge encoded value";
CM_ SG_ 789 Batt_Temp "Battery temperature in Celsius";

